* {
    /* Your color palette */
    rosewater: #f4dbd6;
    flamingo: #f0c6c6;
    pink: #f5bde6;
    mauve: #c6a0f6;
    red: #ed8796;
    maroon: #ee99a0;
    peach: #f5a97f;
    yellow: #eed49f;
    green: #a6da95;
    teal: #8bd5ca;
    sky: #91d7e3;
    sapphire: #7dc4e4;
    blue: #8aadf4;
    lavender: #b7bdf8;
    text: #cad3f5;
    subtext1: #b8c0e0;
    subtext0: #a5adcb;
    overlay2: #939ab7;
    overlay1: #8087a2;
    overlay0: #6e738d;
    surface2: #5b6078;
    surface1: #494d64;
    surface0: #363a4f;
    base: #24273a;
    mantle: #1e2030;
    crust: #181926;

    /* Global Assigns */
    background:                  @base;
    background-color:            @base;
    background-alt:              @surface0;
    foreground:                  @text;
    text-color:                  @text;
    selected:                    @mauve;
    active:                      @green;
    urgent:                      @red;
}

/* Hard structural overrides to lock dark theme backgrounds */
window {
    background-color:            @background;
    border-color:                @selected;
    text-color:                  @foreground;
}

mainbox {
    background-color:            @background;
    text-color:                  @foreground;
}

inputbar {
    background-color:            @background-alt;
    text-color:                  @foreground;
}

prompt {
    background-color:            inherit;
    text-color:                  @selected;
}

entry {
    background-color:            inherit;
    text-color:                  @foreground;
}

listview {
    background-color:            @background;
    text-color:                  @foreground;
}

/* Element rendering rules */
element {
    background-color:            transparent;
    text-color:                  @foreground;
}

element normal.normal {
    background-color:            transparent;
    text-color:                  @foreground;
}

element alternate.normal {
    background-color:            transparent;
    text-color:                  @foreground;
}

element selected.normal {
    background-color:            @selected;
    text-color:                  @background;
}

element-text, element-icon {
    background-color:            inherit;
    text-color:                  inherit;
}