* {
    background:         transparent;
    background-alt:     transparent;
    background-color:   transparent;
    foreground:         #cad3f5;
    urgent:             #ed8796;
    text-color:         #cad3f5;
}

configuration{
    font: "Mono 12";
    show-icons: true;
    location: 5;
    sidebar-mode: false;
    prompt: "search: ";
    alternate-row-color: false;
    fixed-height: false;
}

listview{
    spacing: 0px;
    scrollbar: true;
    overflow:true;
    layout: horizontal;
    
    background-color: transparent;
}

element-icon {
    vertical-align: 0.0;
    size:300px;
    
    padding: 0px 0px;
    margin: 0px;
    spacing:0px 0px;
}

element-text{
    horizontal-align: 0.5;
    vertical-align: 0.5;
}

element.alternate.normal{
    background-color: transparent;
}

element{
    orientation: vertical;
    height: 0px;
    padding: 0px;
    margin: 0px;
    spacing:0px;
    overflow: true;
}

element-text selected {
    enabled:false;
    
    background-color: rgba(202, 211, 245, 0.8);
    text-color: rgba(183, 189, 248, 0.8);
}

window{
    width: 100%;
    height: 38%;
    background-color: rgba(36, 39, 58, 0.55);
    
    border: 0px;
}
