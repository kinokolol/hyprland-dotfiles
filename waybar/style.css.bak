* {
font-family: "JetBrainsMono Nerd Font";
font-size: 14px;
font-weight: 600;
}

.module {
    padding-left: 8px;
    padding-right: 8px;
}

#custom-arch {
color: #7dc4e4;
font-size: 26px;
padding-left: 10px;
}

#custom-arch:hover {
color: #cad3f5;
font-size: 26px;
padding-left: 10px;
}

window#waybar {
    background: #181825;
    border: 2px solid #b4befe;
    border-radius: 15px;
    min-width: 28px;
    min-height:48px;
    padding: 2px 10px; 
}

window#waybar > box {
    margin: 2px 4px;
    padding: 0px;
}

#power-profiles-daemon {
    padding-left: 6px;
    padding-right: 6px;
    background-color: #181825;
}

#power-profiles-daemon.default{
    padding: 4px;
    font-size: 20px;
    background-color:  #181825;
}

#battery.warning {
border: 2px solid #f9e2af;
}

#battery.critical {
border: 2px solid #f38ba8;
}

#network.ethernet {
background-color: #b4befe;
}

#workspaces {
border: 2px solid #b4befe;
border-radius: 10px;
padding-left: 0;
padding-right: 0;
}

#workspaces button {
border-radius: 0;
color: #cdd6f4;
padding-left: 8px;
padding-right: 7px;
}

#workspaces button.active {
    color: #181825;
    background-color: #b4befe;
    border: 2px solid #b4befe;
}

#workspaces button:hover {
    color: #313244;
    background-color: #b4befe;
    box-shadow: inherit;
}

#custom-wallpaper {
    color:#ffffff;
    min-width: 28px;
    padding: 8px;
    margin: 0;
    font-size: 20px;
}

#custom-wallpaper:hover{
    color: #313244;
    background-color: #b4befe;
    padding: 8px;
    font-size: 20px;
}

#custom-brilliant {
    color: #3bcbff;
    min-width: 28px;
    padding: 10px;
    margin: 0;
    font-size: 20px;
}

#custom-brilliant:hover{
    color: #313244;
    background-color: #b4befe;
    padding: 10px;
    font-size: 20px;
}
